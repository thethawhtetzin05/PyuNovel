# Force drizzle-orm to hoist to root, resolving dual-instance type conflicts
# caused by different peer dependency peer hash resolutions (e.g. better-auth + @cloudflare/workers-types)
public-hoist-pattern[]=drizzle-orm
ignore-workspace-root-check=true

# Allow all build scripts (needed for EAS Cloud Build with pnpm v10)
enable-pre-post-scripts=true
